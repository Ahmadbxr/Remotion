{
  "name": "offscript-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Apple-style 16:9 German promo video for offscript.ch, built with Remotion.",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render OffscriptPromo out/offscript-promo.mp4",
    "still": "remotion still OffscriptPromo out/offscript-promo.png",
    "typecheck": "tsc --noEmit",
    "ad:render": "bash scripts/ad/render_all.sh",
    "ad:audio": "python3 scripts/ad/synth_audio.py",
    "ad:brand": "python3 scripts/ad/prepare_brand.py",
    "naia:probe": "bash scripts/naia/probe.sh",
    "naia:run": "bash scripts/naia/run.sh"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@remotion/cli": "4.0.523",
    "@remotion/fonts": "^4.0.523",
    "@remotion/media": "^4.0.523",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.523"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
